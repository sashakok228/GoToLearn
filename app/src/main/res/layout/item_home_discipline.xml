<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="120dp"
    android:layout_marginBottom="20dp"
    android:background="@drawable/streak_box"
    android:padding="8dp">

    <!-- Иконка дисциплины слева -->
    <ImageView
        android:id="@+id/ivIcon"
        android:layout_width="95dp"
        android:layout_height="95dp"
        android:layout_marginStart="8dp"
        android:src="@drawable/ic_negotovlogo"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Название дисциплины -->
    <TextView
        android:id="@+id/tvSubjectTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="60dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:fontFamily="@font/ubuntu_regular"
        android:text="Физика"
        android:textColor="@color/texticons"
        android:textSize="22sp"
        app:layout_constraintStart_toEndOf="@id/ivIcon"
        app:layout_constraintEnd_toStartOf="@id/btnPlay"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Текст прогресса -->
    <TextView
        android:id="@+id/tvProgressRatio"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="@font/ubuntu_bold"
        android:text="10/30"
        android:textColor="@color/texticons"
        android:textSize="20sp"
        app:layout_constraintStart_toStartOf="@id/tvSubjectTitle"
        app:layout_constraintTop_toBottomOf="@id/tvSubjectTitle" />

    <!-- Кнопка play справа -->
    <ImageButton
        android:id="@+id/btnPlay"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_marginEnd="8dp"
        android:background="@android:color/transparent"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_play"
        android:contentDescription="Play"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- Полоска прогресса -->
    <ProgressBar
        android:id="@+id/pbProgress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="0dp"
        android:layout_height="12dp"
        android:layout_marginEnd="45dp"
        android:layout_marginBottom="8dp"
        android:max="100"
        android:progress="30"
        android:progressDrawable="@drawable/custom_progress_bar"
        app:layout_constraintStart_toStartOf="@id/tvSubjectTitle"
        app:layout_constraintEnd_toStartOf="@id/btnPlay"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>