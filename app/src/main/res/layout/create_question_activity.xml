<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fonzakryglen">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="170dp"
        android:background="@color/fonzakryglen"
        app:layout_constraintTop_toTopOf="parent">

        <View
            android:id="@+id/headerCurve"
            android:layout_width="match_parent"
            android:layout_height="170dp"
            android:background="@drawable/header_wave"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/ivAvatar"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_marginStart="30dp"
            android:layout_marginTop="40dp"
            android:src="@drawable/ic_ticket"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvGreeting"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="15dp"
            android:fontFamily="@font/ubuntu_regular"
            android:text="Билеты"
            android:textColor="@color/texticons"
            android:textSize="38sp"
            app:layout_constraintBottom_toBottomOf="@id/ivAvatar"
            app:layout_constraintStart_toEndOf="@id/ivAvatar"
            app:layout_constraintTop_toTopOf="@id/ivAvatar" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <ScrollView
        android:id="@+id/contentScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="false"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigation"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/contentContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="30dp">

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="30dp"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/ubuntu_regular"
                android:gravity="center"
                android:text="Дисциплина"
                android:textColor="@color/texticons"
                android:textSize="34sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageView
                android:id="@+id/ivDisciplineAvatar"
                android:layout_width="115dp"
                android:layout_height="115dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/avatar_box"
                android:contentDescription="Фото дисциплины"
                android:padding="8dp"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_ticket"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvTitle" />

            <TextView
                android:id="@+id/tvChangeAvatar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/ubuntu_regular"
                android:text="Сменить фото"
                android:textColor="@color/texticons"
                android:textSize="21sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/ivDisciplineAvatar" />

            <EditText
                android:id="@+id/etDisciplineName"
                android:layout_width="0dp"
                android:layout_height="55dp"
                android:layout_marginHorizontal="30dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/avatar_box"
                android:fontFamily="@font/ubuntu_regular"
                android:hint="Название дисциплины"
                android:imeOptions="actionDone"
                android:inputType="textCapSentences"
                android:paddingHorizontal="20dp"
                android:singleLine="true"
                android:textColor="@color/texticons"
                android:textColorHint="@color/texticons"
                android:textSize="22sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvChangeAvatar" />

            <Button
                android:id="@+id/btnSaveDisciplineName"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_marginStart="30dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="8dp"
                android:backgroundTint="@color/knopki"
                android:fontFamily="@font/ubuntu_regular"
                android:text="Сохранить"
                android:textAllCaps="false"
                android:textColor="@color/texticons"
                android:textSize="18sp"
                app:cornerRadius="30dp"
                app:layout_constraintEnd_toStartOf="@id/btnDeleteDiscipline"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/etDisciplineName" />

            <Button
                android:id="@+id/btnDeleteDiscipline"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_marginStart="8dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="30dp"
                android:backgroundTint="#FF8A80"
                android:fontFamily="@font/ubuntu_regular"
                android:text="Удалить"
                android:textAllCaps="false"
                android:textColor="@color/texticons"
                android:textSize="18sp"
                app:cornerRadius="30dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/btnSaveDisciplineName"
                app:layout_constraintTop_toBottomOf="@id/etDisciplineName" />

            <EditText
                android:id="@+id/etQuestion"
                android:layout_width="0dp"
                android:layout_height="130dp"
                android:layout_marginHorizontal="30dp"
                android:layout_marginTop="22dp"
                android:background="@drawable/avatar_box"
                android:fontFamily="@font/ubuntu_regular"
                android:gravity="top"
                android:hint="Вопрос"
                android:imeOptions="actionNext"
                android:inputType="textMultiLine|textCapSentences"
                android:minLines="3"
                android:padding="20dp"
                android:textColor="@color/texticons"
                android:textColorHint="@color/texticons"
                android:textSize="22sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/btnSaveDisciplineName" />

            <EditText
                android:id="@+id/etAnswer"
                android:layout_width="0dp"
                android:layout_height="130dp"
                android:layout_marginHorizontal="30dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/avatar_box"
                android:fontFamily="@font/ubuntu_regular"
                android:gravity="top"
                android:hint="Ответ"
                android:imeOptions="actionDone"
                android:inputType="textMultiLine|textCapSentences"
                android:minLines="3"
                android:padding="20dp"
                android:textColor="@color/texticons"
                android:textColorHint="@color/texticons"
                android:textSize="22sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/etQuestion" />

            <Button
                android:id="@+id/btnCreateQuestion"
                android:layout_width="0dp"
                android:layout_height="55dp"
                android:layout_marginHorizontal="40dp"
                android:layout_marginTop="24dp"
                android:backgroundTint="@color/knopki"
                android:fontFamily="@font/ubuntu_regular"
                android:text="Создание вопроса"
                android:textAllCaps="false"
                android:textColor="@color/texticons"
                android:textSize="24sp"
                app:cornerRadius="30dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/etAnswer" />

            <Button
                android:id="@+id/btnQuestionList"
                android:layout_width="0dp"
                android:layout_height="55dp"
                android:layout_marginHorizontal="40dp"
                android:layout_marginTop="14dp"
                android:backgroundTint="@color/knopki"
                android:fontFamily="@font/ubuntu_regular"
                android:text="Список вопросов"
                android:textAllCaps="false"
                android:textColor="@color/texticons"
                android:textSize="24sp"
                app:cornerRadius="30dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/btnCreateQuestion" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </ScrollView>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:background="@drawable/bottom_nav_bg"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:paddingTop="14dp"
            app:layout_constraintEnd_toStartOf="@+id/navProfile"
            app:layout_constraintStart_toStartOf="parent">

            <ImageView
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:src="@drawable/ic_home"
                app:tint="@color/texticons" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/navProfile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="14dp"
            app:layout_constraintEnd_toStartOf="@+id/navLibrary"
            app:layout_constraintStart_toEndOf="@+id/navHome">

            <ImageView
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:src="@drawable/ic_avaterbook" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/navLibrary"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="14dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/navProfile">

            <ImageView
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:src="@drawable/ic_book"
                app:tint="@color/texticons" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>