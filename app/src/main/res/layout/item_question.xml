<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp"
    android:background="@drawable/avatar_box"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvQuestionNumber"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:fontFamily="@font/ubuntu_regular"
        android:text="Вопрос №1"
        android:textColor="@color/texticons"
        android:textSize="22sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvQuestionText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:fontFamily="@font/ubuntu_regular"
        android:text="Текст вопроса"
        android:textColor="@color/texticons"
        android:textSize="18sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvQuestionNumber" />

    <TextView
        android:id="@+id/tvCorrectAnswer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="@font/ubuntu_regular"
        android:text="Ответ"
        android:textColor="@color/texticons"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvQuestionText" />

    <Button
        android:id="@+id/btnEditQuestion"
        android:layout_width="0dp"
        android:layout_height="46dp"
        android:layout_marginTop="14dp"
        android:layout_marginEnd="8dp"
        android:backgroundTint="@color/knopki"
        android:fontFamily="@font/ubuntu_regular"
        android:text="Редактировать"
        android:textAllCaps="false"
        android:textColor="@color/texticons"
        android:textSize="15sp"
        app:cornerRadius="24dp"
        app:layout_constraintEnd_toStartOf="@id/btnDeleteQuestion"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvCorrectAnswer" />

    <Button
        android:id="@+id/btnDeleteQuestion"
        android:layout_width="0dp"
        android:layout_height="46dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="14dp"
        android:backgroundTint="#FF8A80"
        android:fontFamily="@font/ubuntu_regular"
        android:text="Удалить"
        android:textAllCaps="false"
        android:textColor="@color/texticons"
        android:textSize="15sp"
        app:cornerRadius="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/btnEditQuestion"
        app:layout_constraintTop_toBottomOf="@id/tvCorrectAnswer" />

</androidx.constraintlayout.widget.ConstraintLayout>