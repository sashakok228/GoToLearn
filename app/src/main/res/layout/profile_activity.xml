<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fonzakryglen">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="255dp"
        android:background="@color/fonzakryglen"
        app:layout_constraintTop_toTopOf="parent">

        <View
            android:id="@+id/headerCurve"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/header_wave"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/ivProfileIcon"
            android:layout_width="82dp"
            android:layout_height="82dp"
            android:layout_marginStart="32dp"
            android:layout_marginTop="48dp"
            android:contentDescription="Аватар"
            android:src="@drawable/ic_profile"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/texticons" />

        <TextView
            android:id="@+id/tvGreeting"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="24dp"
            android:ellipsize="end"
            android:fontFamily="@font/ubuntu_regular"
            android:maxLines="2"
            android:text="Привет, User!"
            android:textColor="@color/texticons"
            android:textSize="30sp"
            app:layout_constraintBottom_toBottomOf="@id/ivProfileIcon"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/ivProfileIcon"
            app:layout_constraintTop_toTopOf="@id/ivProfileIcon" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <ScrollView
        android:id="@+id/contentScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="false"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigation"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="10dp"
            android:paddingBottom="120dp">

            <EditText
                android:id="@+id/etUsername"
                android:layout_width="0dp"
                android:layout_height="55dp"
                android:layout_marginHorizontal="35dp"
                android:layout_marginTop="0dp"
                android:background="@drawable/rounded_input"
                android:drawableStart="@drawable/ic_profile"
                android:drawablePadding="12dp"
                android:fontFamily="@font/ubuntu_regular"
                android:hint="Имя"
                android:inputType="textPersonName"
                android:paddingHorizontal="18dp"
                android:singleLine="true"
                android:textColor="@color/texticons"
                android:textColorHint="@color/texticons"
                android:textSize="20sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <Button
                android:id="@+id/btnChangeUsername"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginHorizontal="35dp"
                android:layout_marginTop="10dp"
                android:backgroundTint="@color/knopki"
                android:fontFamily="@font/ubuntu_regular"
                android:text="Сменить имя"
                android:textAllCaps="false"
                android:textColor="@color/texticons"
                android:textSize="18sp"
                app:cornerRadius="30dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/etUsername" />

            <EditText
                android:id="@+id/etEmail"
                android:layout_width="0dp"
                android:layout_height="55dp"
                android:layout_marginHorizontal="35dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/rounded_input"
                android:drawableStart="@drawable/ic_email"
                android:drawablePadding="12dp"
                android:fontFamily="@font/ubuntu_regular"
                android:hint="Почта"
                android:inputType="textEmailAddress"
                android:paddingHorizontal="18dp"
                android:singleLine="true"
                android:textColor="@color/texticons"
                android:textColorHint="@color/texticons"
                android:textSize="20sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/btnChangeUsername" />

            <Button
                android:id="@+id/btnChangeEmail"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginHorizontal="35dp"
                android:layout_marginTop="10dp"
                android:backgroundTint="@color/knopki"
                android:fontFamily="@font/ubuntu_regular"
                android:text="Сменить почту"
                android:textAllCaps="false"
                android:textColor="@color/texticons"
                android:textSize="18sp"
                app:cornerRadius="30dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/etEmail" />

            <TextView
                android:id="@+id/tvSecurity"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="35dp"
                android:layout_marginTop="24dp"
                android:fontFamily="@font/ubuntu_regular"
                android:text="Security"
                android:textColor="@color/texticons"
                android:textSize="24sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/btnChangeEmail" />

            <TextView
                android:id="@+id/tvSecurityDescription"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="35dp"
                android:layout_marginTop="12dp"
                android:fontFamily="@font/ubuntu_regular"
                android:text="Чтобы изменить пароль, введите свой старый пароль"
                android:textColor="@color/texticons"
                android:textSize="16sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvSecurity" />

            <EditText
                android:id="@+id/etPassword"
                android:layout_width="0dp"
                android:layout_height="55dp"
                android:layout_marginHorizontal="35dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/rounded_input"
                android:drawableStart="@drawable/ic_lock"
                android:drawablePadding="12dp"
                android:fontFamily="@font/ubuntu_regular"
                android:hint="Password"
                android:inputType="textPassword"
                android:paddingHorizontal="18dp"
                android:singleLine="true"
                android:textColor="@color/texticons"
                android:textColorHint="@color/texticons"
                android:textSize="20sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvSecurityDescription" />

            <Button
                android:id="@+id/btnChangePassword"
                android:layout_width="0dp"
                android:layout_height="55dp"
                android:layout_marginHorizontal="35dp"
                android:layout_marginTop="16dp"
                android:backgroundTint="@color/knopki"
                android:fontFamily="@font/ubuntu_regular"
                android:text="Сменить пароль"
                android:textAllCaps="false"
                android:textColor="@color/texticons"
                android:textSize="20sp"
                app:cornerRadius="30dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/etPassword" />

            <Button
                android:id="@+id/btnLogout"
                android:layout_width="0dp"
                android:layout_height="55dp"
                android:layout_marginHorizontal="35dp"
                android:layout_marginTop="20dp"
                android:backgroundTint="#E53935"
                android:fontFamily="@font/ubuntu_regular"
                android:text="Выйти из аккаунта"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="20sp"
                app:cornerRadius="30dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/btnChangePassword" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </ScrollView>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:background="@drawable/bottom_nav_bg"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:paddingTop="14dp"
            app:layout_constraintEnd_toStartOf="@+id/navProfile"
            app:layout_constraintStart_toStartOf="parent">

            <ImageView
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:src="@drawable/ic_home"
                app:tint="@color/texticons" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/navProfile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="14dp"
            app:layout_constraintEnd_toStartOf="@+id/navLibrary"
            app:layout_constraintStart_toEndOf="@+id/navHome">

            <ImageView
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:src="@drawable/ic_avaterbook" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/navLibrary"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="14dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/navProfile">

            <ImageView
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:src="@drawable/ic_book"
                app:tint="@color/texticons" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>