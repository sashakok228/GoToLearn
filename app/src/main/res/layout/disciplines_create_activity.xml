<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fonzakryglen">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/fonzakryglen"
        android:id="@+id/header"
        android:paddingBottom="30dp"
        tools:ignore="MissingConstraints">

        <!-- Волна (фон), которая уходит вниз -->
        <View
            android:id="@+id/headerCurve"
            android:layout_width="match_parent"
            android:layout_height="170dp"
            android:background="@drawable/header_wave"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Аватар пользователя (слева) -->
        <ImageView
            android:id="@+id/ivAvatar"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_marginStart="30dp"
            android:layout_marginTop="40dp"
            android:src="@drawable/ic_openbook"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Приветствие (справа от аватара) -->
        <TextView
            android:id="@+id/tvGreeting"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="15dp"
            android:paddingBottom="30dp"
            android:fontFamily="@font/ubuntu_regular"
            android:text="Disciplines"
            android:textColor="@color/texticons"
            android:textSize="40sp"
            app:layout_constraintBottom_toBottomOf="@id/ivAvatar"
            app:layout_constraintStart_toEndOf="@id/ivAvatar"
            app:layout_constraintTop_toTopOf="@id/ivAvatar" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="0dp"
        android:fontFamily="@font/ubuntu_regular"
        android:text="Создание дисциплины"
        android:textColor="@color/texticons"
        android:textSize="30sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header" />

    <!-- Поле ввода названия -->
    <EditText
        android:id="@+id/etDisciplineName"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:layout_marginHorizontal="40dp"
        android:layout_marginTop="25dp"
        android:background="@drawable/rounded_input"
        android:fontFamily="@font/ubuntu_regular"
        android:hint="Название дисциплины"
        android:textSize="24sp"
        android:paddingHorizontal="20dp"
        android:textColorHint="@color/texticons"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvTitle" />

    <!-- Область выбора аватара -->
    <ImageView
        android:id="@+id/ivDisciplineAvatar"
        android:layout_width="160dp"
        android:layout_height="160dp"
        android:layout_marginTop="40dp"
        android:background="@drawable/avatar_box"
        android:padding="30dp"
        android:src="@drawable/ic_negotovlogo"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/etDisciplineName" />

    <TextView
        android:id="@+id/tvSelectAvatar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:fontFamily="@font/ubuntu_regular"
        android:text="Выбрать аватар"
        android:textColor="@color/vidilenievsego"
        android:textSize="25sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ivDisciplineAvatar" />

    <!-- Кнопка Создать -->
    <Button
        android:id="@+id/btnCreate"
        android:layout_width="0dp"
        android:layout_height="55dp"
        android:layout_marginHorizontal="40dp"
        android:layout_marginBottom="30dp"
        android:backgroundTint="@color/knopki"
        android:fontFamily="@font/ubuntu_regular"
        android:text="Создать дисциплину"
        android:textAllCaps="false"
        android:textColor="@color/texticons"
        android:textSize="25sp"
        app:cornerRadius="30dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/bottomNavigation" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:background="@drawable/bottom_nav_bg"
        android:elevation="0dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Кнопка: HOME -->
        <LinearLayout
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:paddingTop="14dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/navProfile">



            <ImageView
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:src="@drawable/ic_home"
                app:tint="@color/texticons" />
        </LinearLayout>

        <!-- Кнопка: PROFILE (Аватар с книгой) -->
        <LinearLayout
            android:id="@+id/navProfile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="14dp"
            app:layout_constraintStart_toEndOf="@+id/navHome"
            app:layout_constraintEnd_toStartOf="@+id/navLibrary">

            <ImageView
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:src="@drawable/ic_avaterbook" /> <!-- Используй иконку с человечком и книгой -->
        </LinearLayout>

        <!-- Кнопка: LIBRARY (Книга) -->
        <LinearLayout
            android:id="@+id/navLibrary"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:paddingTop="14dp"
            android:orientation="vertical"

            app:layout_constraintStart_toEndOf="@+id/navProfile"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageView
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:src="@drawable/ic_book"
                app:tint="@color/texticons" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>


</androidx.constraintlayout.widget.ConstraintLayout>