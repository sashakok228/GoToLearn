<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fonzakryglen">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="255dp"
        android:background="@color/fonzakryglen"
        app:layout_constraintTop_toTopOf="parent">

        <View
            android:id="@+id/headerCurve"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/header_wave"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/ivLockIcon"
            android:layout_width="82dp"
            android:layout_height="82dp"
            android:layout_marginStart="32dp"
            android:layout_marginTop="48dp"
            android:src="@drawable/ic_lock"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/texticons" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="24dp"
            android:fontFamily="@font/ubuntu_regular"
            android:text="Новый пароль"
            android:textColor="@color/texticons"
            android:textSize="32sp"
            app:layout_constraintBottom_toBottomOf="@id/ivLockIcon"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/ivLockIcon"
            app:layout_constraintTop_toTopOf="@id/ivLockIcon" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <ScrollView
        android:id="@+id/contentScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="false"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigation"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="20dp"
            android:paddingBottom="35dp">

            <TextView
                android:id="@+id/tvDescription"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="35dp"
                android:fontFamily="@font/ubuntu_regular"
                android:text="Введите новый пароль и повторите его"
                android:textColor="@color/texticons"
                android:textSize="18sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <EditText
                android:id="@+id/etNewPassword"
                android:layout_width="0dp"
                android:layout_height="55dp"
                android:layout_marginHorizontal="35dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/rounded_input"
                android:drawableStart="@drawable/ic_lock"
                android:drawablePadding="12dp"
                android:fontFamily="@font/ubuntu_regular"
                android:hint="Новый пароль"
                android:inputType="textPassword"
                android:paddingHorizontal="18dp"
                android:singleLine="true"
                android:textColor="@color/texticons"
                android:textColorHint="@color/texticons"
                android:textSize="20sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvDescription" />

            <EditText
                android:id="@+id/etConfirmPassword"
                android:layout_width="0dp"
                android:layout_height="55dp"
                android:layout_marginHorizontal="35dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/rounded_input"
                android:drawableStart="@drawable/ic_lock"
                android:drawablePadding="12dp"
                android:fontFamily="@font/ubuntu_regular"
                android:hint="Повторите пароль"
                android:inputType="textPassword"
                android:paddingHorizontal="18dp"
                android:singleLine="true"
                android:textColor="@color/texticons"
                android:textColorHint="@color/texticons"
                android:textSize="20sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/etNewPassword" />

            <Button
                android:id="@+id/btnSavePassword"
                android:layout_width="0dp"
                android:layout_height="55dp"
                android:layout_marginHorizontal="35dp"
                android:layout_marginTop="24dp"
                android:backgroundTint="@color/knopki"
                android:fontFamily="@font/ubuntu_regular"
                android:text="Сохранить пароль"
                android:textAllCaps="false"
                android:textColor="@color/texticons"
                android:textSize="20sp"
                app:cornerRadius="30dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/etConfirmPassword" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </ScrollView>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:background="@drawable/bottom_nav_bg"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:paddingTop="14dp"
            app:layout_constraintEnd_toStartOf="@+id/navProfile"
            app:layout_constraintStart_toStartOf="parent">

            <ImageView
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:src="@drawable/ic_home"
                app:tint="@color/texticons" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/navProfile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="14dp"
            app:layout_constraintEnd_toStartOf="@+id/navLibrary"
            app:layout_constraintStart_toEndOf="@+id/navHome">

            <ImageView
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:src="@drawable/ic_avaterbook" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/navLibrary"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="14dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/navProfile">

            <ImageView
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:src="@drawable/ic_book"
                app:tint="@color/texticons" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>